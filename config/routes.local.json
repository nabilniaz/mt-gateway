{
  "routes": [
    {
      "route_id": "echo",
      "prefix": "/echo",
      "upstream": "http://127.0.0.1:9000/v1",
      "required_scopes": [
        "echo:read"
      ],
      "canary": {
        "upstream": "http://127.0.0.1:9000/v2",
        "percent": 20
      }
    },
    {
      "route_id": "flaky",
      "prefix": "/flaky",
      "upstream": "http://127.0.0.1:9000/status",
      "required_scopes": [
        "echo:read"
      ],
      "circuit_breaker": {
        "failure_threshold": 3,
        "cooldown_seconds": 15,
        "half_open_max_probes": 1
      }
    },
    {
      "route_id": "slow",
      "prefix": "/slow",
      "upstream": "http://127.0.0.1:9000/delay",
      "required_scopes": [
        "echo:read"
      ],
      "timeout_seconds": 2
    },
    {
      "route_id": "httpbin",
      "prefix": "/httpbin",
      "upstream": "https://httpbin.org",
      "required_scopes": [
        "httpbin:read"
      ]
    }
  ]
}
